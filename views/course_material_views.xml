<odoo>
    <record id="view_material_tree" model="ir.ui.view">
        <field name="name">course.material.tree</field>
        <field name="model">course.material</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="type"/>
                <field name="course_id"/>
            </tree>
        </field>
    </record>


    <record id="view_material_form" model="ir.ui.view">
        <field name="name">course.material.form</field>
        <field name="model">course.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="file" filename="file_name"/>
                        <field name="link"/>
                        <field name="course_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>