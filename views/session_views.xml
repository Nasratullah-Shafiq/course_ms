<odoo>
    <record id="view_session_tree" model="ir.ui.view">
        <field name="name">course.session.tree</field>
        <field name="model">course.session</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="course_id"/>
                <field name="instructor_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
            </tree>
        </field>
    </record>


    <record id="view_session_form" model="ir.ui.view">
        <field name="name">course.session.form</field>
        <field name="model">course.session</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="course_id"/>
                        <field name="instructor_id"/>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="location"/>
                        <field name="student_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>o>